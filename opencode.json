{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "magistrate",
  "skills": {
    "paths": [".opencode/skills"]
  },
  "agent": {
    "magistrate": {
      "model": "anthropic/claude-sonnet-4-6",
      "mode": "primary",
      "description": "[v2.0] 裁判裁决PM — 综合engine定量+两路专家输入，拍板结论/折价率/仓位，唯一签收人",
      "permission": {
        "edit": "ask",
        "bash": {
          "ls *": "allow",
          "cat *": "allow",
          "python3 engine/*": "allow",
          "*": "ask"
        }
      },
      "skills": ["valuation-modeling-skill", "portfolio-construction-skill", "adversarial-skeptic-skill", "professional-reporting-skill", "citation-engine-skill"]
    },
    "forensic-auditor": {
      "model": "anthropic/claude-sonnet-4-6",
      "mode": "subagent",
      "description": "[v2.0] 法证猎手 — 定性排雷：问询函/附注/漂移/流水，只找矛盾打分，不算术",
      "permission": {
        "edit": "deny",
        "bash": {
          "ls *": "allow",
          "cat *": "allow",
          "*": "ask"
        }
      },
      "skills": ["pii-sanitizer-skill", "black-account-checker", "quantitative-fraud-metrics", "governance-redflags-skill"]
    },
    "business-strategist": {
      "model": "anthropic/claude-sonnet-4-6",
      "mode": "subagent",
      "description": "[v2.0] 商业分析师 — 护城河/增速/指引/Consensus预期差，只回答Alpha在哪，不算术",
      "permission": {
        "edit": "deny",
        "bash": {
          "ls *": "allow",
          "cat *": "allow",
          "*": "ask"
        }
      },
      "skills": ["peer-comparison-skill", "macro-context-skill", "sentiment-event-skill", "consensus-benchmarker-skill", "financial-research-skill"]
    }
  }
}
